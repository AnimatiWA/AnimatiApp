<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/gradient_login"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/titulo_pago"
            android:text="Procesando tu pago..."
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/subtitulo_pago"
            android:text="Por favor, aguardá unos instantes mientras confirmamos el estado de tu compra."
            android:textSize="16sp"
            android:textColor="#666666"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <ProgressBar
            android:id="@+id/progress_bar_pago"
            style="?android:attr/progressBarStyleLarge"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="#003366"/>

        <TextView
            android:id="@+id/texto_procesando_pago"
            android:text="Estamos procesando tu pago, por favor no cierres esta pantalla..."
            android:textColor="#888888"
            android:textSize="14sp"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_marginBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/total_price"
            android:text="Total: $0.00"
            android:textSize="18sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/mensaje_demora"
            android:text="⚠️ El pago está tardando más de lo habitual..."
            android:textColor="#B00020"
            android:textSize="14sp"
            android:visibility="gone"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
